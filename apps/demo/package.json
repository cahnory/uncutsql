{
  "name": "@uncutsql/demo",
  "version": "0.1.0",
  "files": [
    "dist/index.js",
    "examples"
  ],
  "type": "module",
  "publishConfig": {
    "main": "./dist/index.js",
    "access": "public"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:test": "node --test --test-reporter=../../scripts/test-reporter.ts tests/*.test.ts",
    "cli": "uncutsql",
    "build": "tsc --noCheck --noResolve --module esnext --target esnext --outDir dist src/index.ts"
  },
  "dependencies": {
    "@uncutsql/codec": "workspace:*",
    "@uncutsql/sqlite": "workspace:*",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@uncutsql/cli": "workspace:*",
    "@uncutsql/core": "workspace:*",
    "@uncutsql/sqlite-driver": "workspace:*"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
