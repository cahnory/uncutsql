{
  "name": "uncutsql-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "libs/*",
      "apps/*"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './libs/**' -r build",
    "check": "concurrently --names format,lint,test,types --group \"pnpm check:format\" \"pnpm check:lint\" \"pnpm check:test\" \"pnpm check:types\"",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --deny-warnings",
    "check:test": "pnpm --reporter=append-only -r --no-bail --aggregate-output run check:test",
    "check:types": "tsc --noEmit && pnpm --reporter=append-only -r --no-bail --aggregate-output run check:types",
    "test": "pnpm check:test",
    "demo": "pnpm --filter @uncutsql/demo dev",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "cli": "node apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.4.2"
}
